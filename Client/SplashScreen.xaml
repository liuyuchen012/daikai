<Window x:Class="CheckIn.Client.SplashScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        Width="420" Height="360">

    <Border CornerRadius="16" Background="White"
            BorderBrush="#e0e0e0" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="4" Color="#30000000" Opacity="0.35"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Logo 带呼吸缩放动画 -->
            <Border Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Margin="0,48,0,16" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="LogoScale"/>
                </Border.RenderTransform>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="LogoScale"
                                                 Storyboard.TargetProperty="ScaleX"
                                                 From="0.9" To="1.1" Duration="0:0:1.2"
                                                 AutoReverse="True" RepeatBehavior="Forever"/>
                                <DoubleAnimation Storyboard.TargetName="LogoScale"
                                                 Storyboard.TargetProperty="ScaleY"
                                                 From="0.9" To="1.1" Duration="0:0:1.2"
                                                 AutoReverse="True" RepeatBehavior="Forever"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <svgc:SvgViewbox Source="logo.svg" Width="160" Height="160" Opacity="0">
                    <svgc:SvgViewbox.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     From="0" To="1" Duration="0:0:0.6"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </svgc:SvgViewbox.Triggers>
                </svgc:SvgViewbox>
            </Border>

            <!-- 应用名称（淡入） -->
            <TextBlock Grid.Row="1" Text="SignWave" FontSize="28" FontWeight="Bold"
                       Foreground="#4285f4" HorizontalAlignment="Center" Margin="0,0,0,8"
                       Opacity="0">
                <TextBlock.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.8" BeginTime="0:0:0.3"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </TextBlock.Triggers>
            </TextBlock>

            <!-- 加载动画 + 提示文字 -->
            <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,36">
                <!-- 进度条往返动画 -->
                <Grid Width="140" Height="4" Margin="0,0,0,12" ClipToBounds="True">
                    <Border CornerRadius="2" Background="#e8e8e8"/>
                    <Border CornerRadius="2" Background="#4285f4"
                            Width="50" HorizontalAlignment="Left">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="ProgressTransform"/>
                        </Border.RenderTransform>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="ProgressTransform"
                                                         Storyboard.TargetProperty="X"
                                                         From="0" To="90" Duration="0:0:0.8"
                                                         AutoReverse="True"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                    </Border>
                </Grid>
                <TextBlock Text="正在加载..." FontSize="12" Foreground="#999"
                           HorizontalAlignment="Center" Opacity="0">
                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     From="0" To="1" Duration="0:0:0.5" BeginTime="0:0:0.5"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </TextBlock.Triggers>
                </TextBlock>
            </StackPanel>
        </Grid>
    </Border>
</Window>
