<Window x:Class="CheckIn.Client.MainWindow" x:Name="ThisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CheckIn.Client.ViewModels"
        xmlns:models="clr-namespace:CheckIn.Client.Models"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="850" Width="1530"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        Icon="icon.ico"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="0" ResizeBorderThickness="6" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 现代化圆角 ContextMenu 样式 -->
        <Style x:Key="ModernContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#e0e0e0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border CornerRadius="10" Background="White"
                                BorderBrush="#e0e0e0" BorderThickness="1"
                                Padding="4" Effect="{x:Null}">
                            <ItemsPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 任务树节点样式 -->
        <Style x:Key="TaskTreeViewItemStyle" TargetType="TreeViewItem">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="4"
                                    Padding="{TemplateBinding Padding}" Margin="2,1">
                                <ContentPresenter ContentSource="Header"/>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#e8f0fe"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#d2e3fc"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 标签页内容模板：排名 + 打卡面板 -->
        <DataTemplate x:Key="TabContentTemplate" DataType="{x:Type vm:TaskTabViewModel}">
            <Grid Margin="20,12,20,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：排名 -->
                <Border Grid.Column="0" CornerRadius="8" Background="#f8f9fa" Padding="12" Margin="0,0,16,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="打卡排名" FontSize="16" FontWeight="SemiBold"
                                   Foreground="#333" Margin="0,0,0,4"/>
                        <TextBlock DockPanel.Dock="Top" Text="最早打卡" FontSize="12" Foreground="#888" Margin="0,0,0,8"/>
                        <ListView ItemsSource="{Binding Ranking}" FontSize="13"
                                  BorderThickness="0" Background="Transparent">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,5" Margin="0,1" CornerRadius="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="70"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Rank}" FontWeight="Bold"
                                                       Foreground="{Binding Rank, Converter={StaticResource RankColorConverter}}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Time}" Foreground="#888"
                                                       FontSize="12" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </DockPanel>
                </Border>

                <!-- 右侧：打卡面板 -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- 状态信息行 -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="13"
                                       Foreground="#666" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{Binding StatusColor}" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#777"/>
                            </StackPanel>
                        </Grid>

                        <!-- 统计条 -->
                        <Border CornerRadius="8" Background="#e8f0fe" Padding="14,10" Margin="0,0,0,14">
                            <TextBlock Text="{Binding PunchInfo}" FontSize="14" FontWeight="Medium" Foreground="#4285f4"/>
                        </Border>

                        <!-- 学生按钮网格 -->
                        <ItemsControl ItemsSource="{Binding Students}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding Config.ButtonCols}" Rows="{Binding Config.ButtonRows}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:StudentModel">
                                    <Button Margin="4" Height="52" FontSize="15" FontWeight="Medium"
                                            Command="{Binding DataContext.CheckInCommand, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                            CommandParameter="{Binding}"
                                            Content="{Binding Name}"
                                            BorderThickness="1" Cursor="Hand"
                                            ToolTip="左键打卡 · 右键取消"
                                            ContextMenuService.Placement="MousePoint">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#e8e8e8"/>
                                                <Setter Property="Foreground" Value="#333"/>
                                                <Setter Property="BorderBrush" Value="#d0d0d0"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Name="Bg" Background="{TemplateBinding Background}"
                                                                    CornerRadius="8"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bg" Property="Opacity" Value="0.85"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCheckedIn}" Value="True">
                                                        <Setter Property="Background" Value="#4285f4"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Setter Property="BorderBrush" Value="#4285f4"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Button.ContextMenu>
                                            <ContextMenu Style="{StaticResource ModernContextMenu}">
                                                <MenuItem Header="取消打卡"
                                                          Command="{Binding DataContext.CancelCheckInCommand, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                                          CommandParameter="{Binding}"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <Border CornerRadius="12" Background="White" Margin="0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="2" Color="#40000000" Opacity="0.3"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ============ 左侧：任务列表侧边栏 ============ -->
                <Border Grid.Column="0" Background="#f5f5f5" CornerRadius="12,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="48"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 标题栏（左侧） -->
                        <Border Grid.Row="0" Background="#4285f4" CornerRadius="12,0,0,0" MouseLeftButtonDown="TitleBar_MouseDown">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                <Ellipse Width="10" Height="10" Fill="White" Opacity="0.9"/>
                                <TextBlock Text=" AgoraIn" FontSize="13" FontWeight="SemiBold"
                                           Foreground="White" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- 任务树 -->
                        <TreeView Grid.Row="1" ItemsSource="{Binding TaskTree}" BorderThickness="0"
                                  Background="Transparent" Padding="8,8,8,0"
                                  SelectedItemChanged="TaskTree_SelectedItemChanged"
                                  ContextMenuOpening="TaskTree_ContextMenuOpening"
                                  x:Name="TaskTreeView">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem" BasedOn="{StaticResource TaskTreeViewItemStyle}"/>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ContextMenu>
                                <ContextMenu Style="{StaticResource ModernContextMenu}">
                                    <MenuItem Header="打开" Tag="Open" Click="TaskTreeMenu_Click"/>
                                    <MenuItem Header="属性" Tag="Properties" Click="TaskTreeMenu_Click"/>
                                    <Separator/>
                                    <MenuItem Header="重命名" Tag="Rename" Click="TaskTreeMenu_Click"/>
                                    <Separator/>
                                    <MenuItem Header="删除" Tag="Delete" Click="TaskTreeMenu_Click" Foreground="#d32f2f"/>
                                </ContextMenu>
                            </TreeView.ContextMenu>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- 文件夹图标 -->
                                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                   Foreground="#666" Margin="0,0,6,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="&#xE8B7;"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFolder}" Value="False">
                                                            <Setter Property="Text" Value="&#xE8A5;"/>
                                                            <Setter Property="Foreground" Value="#4285f4"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <!-- 名称 -->
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                   Foreground="#333" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Grid>
                </Border>

                <!-- ============ 右侧：主内容区 ============ -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="28"/>
                    </Grid.RowDefinitions>

                    <!-- 标题栏（右侧） -->
                    <Grid Grid.Row="0" Background="#4285f4" MouseLeftButtonDown="TitleBar_MouseDown">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 菜单按钮 -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                            <Button Content="文件" Style="{StaticResource FlatButton}" Foreground="White"
                                    FontSize="13" Click="MenuFile_Click"/>
                            <Button Content="远程" Style="{StaticResource FlatButton}" Foreground="White"
                                    FontSize="13" Click="MenuRemote_Click"/>
                            <Button Content="设置" Style="{StaticResource FlatButton}" Foreground="White"
                                    FontSize="13" Click="MenuSettings_Click"/>
                            <Button Content="帮助" Style="{StaticResource FlatButton}" Foreground="White"
                                    FontSize="13" Click="MenuHelp_Click"/>
                        </StackPanel>

                        <!-- 右侧控制按钮 -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="─" Width="46" Height="30" Foreground="White"
                                    Background="Transparent" BorderThickness="0" FontSize="16"
                                    Click="Minimize_Click" Cursor="Hand"/>
                            <Button Content="☐" Width="46" Height="30" Foreground="White"
                                    Background="Transparent" BorderThickness="0" FontSize="14"
                                    Click="Maximize_Click" Cursor="Hand"/>
                            <Button Content="✕" Width="46" Height="30" Foreground="White"
                                    Background="Transparent" BorderThickness="0" FontSize="14"
                                    Click="Close_Click" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>

                    <!-- 标签栏 -->
                    <Border Grid.Row="1" Background="#f0f0f0" BorderBrush="#e0e0e0" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 标签页列表 -->
                            <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          HorizontalContentAlignment="Left">
                                <ItemsControl ItemsSource="{Binding Tabs}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="TabBorder" Margin="1,0" Padding="12,0"
                                                    Cursor="Hand" MinWidth="100" Height="36"
                                                    Background="Transparent" BorderThickness="0"
                                                    MouseLeftButtonDown="Tab_MouseLeftButtonDown"
                                                    Tag="{Binding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding TabDisplayName}"
                                                               FontSize="12" Foreground="#555"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                                                    <Button Grid.Column="1" Content="✕" FontSize="10"
                                                            Width="18" Height="18" Margin="6,0,0,0"
                                                            Foreground="#999" Background="Transparent"
                                                            BorderThickness="0" Cursor="Hand"
                                                            VerticalAlignment="Center"
                                                            Click="TabClose_Click"
                                                            ToolTip="关闭标签">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="Bdr" CornerRadius="3"
                                                                                    Background="Transparent"
                                                                                    Width="{TemplateBinding Width}"
                                                                                    Height="{TemplateBinding Height}">
                                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                                  VerticalAlignment="Center"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="Bdr" Property="Background" Value="#e0e0e0"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=IsSelected}" Value="True">
                                                    <Setter TargetName="TabBorder" Property="Background" Value="White"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- 新建标签按钮 -->
                            <Button Grid.Column="1" Content="+" FontSize="18" FontWeight="Light"
                                    Width="36" Height="36" Foreground="#666"
                                    Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" Click="AddTab_Click" ToolTip="新建打卡任务">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bdr" CornerRadius="0"
                                                            Background="Transparent"
                                                            Width="{TemplateBinding Width}"
                                                            Height="{TemplateBinding Height}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bdr" Property="Background" Value="#e0e0e0"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- 主内容区（绑定到活跃标签） -->
                    <ContentControl Grid.Row="2"
                                    Content="{Binding ActiveTab}"
                                    ContentTemplate="{StaticResource TabContentTemplate}"/>

                    <!-- 无标签时的占位提示 -->
                    <Border Grid.Row="2" Visibility="{Binding HasActiveTab, Converter={StaticResource InverseBoolToVis}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="没有打开的打卡任务" FontSize="16" Foreground="#bbb" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="从左侧任务列表选择任务" FontSize="12" Foreground="#ccc" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- 底部状态栏 -->
                    <Border Grid.Row="3" Background="#f5f5f5" Padding="12,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding ActiveTab.StatusMessage, FallbackValue='就绪'}" FontSize="11" Foreground="#888" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="右键点击已打卡学生可取消打卡" FontSize="11" Foreground="#aaa" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
