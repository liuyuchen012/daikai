<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <AssemblyName>AgoraIn</AssemblyName>
    <Product>AgoraIn</Product>
    <AssemblyVersion>3.2.5.0</AssemblyVersion>
    <FileVersion>3.2.5.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="logo.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpVectors" Version="1.8.4" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <!-- H2：私钥使用 Windows DPAPI（ProtectedData）加密存储，不落明文；
         该类型由 net10.0-windows 的 WindowsDesktop 框架内置提供 -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\CheckIn.Shared.csproj" />
  </ItemGroup>

</Project>
