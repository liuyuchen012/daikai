<Window x:Class="CheckIn.Client.ClassHoursWindow" x:Name="ThisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CheckIn.Client"
        mc:Ignorable="d"
        Title="课时划消管理" Height="760" Width="1280"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="0" ResizeBorderThickness="6" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 现代化圆角 ContextMenu 样式（与嵌入版共享，供标题栏菜单使用） -->
        <Style x:Key="ModernContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#e0e0e0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border CornerRadius="10" Background="White"
                                BorderBrush="#e0e0e0" BorderThickness="1"
                                Padding="4" Effect="{x:Null}">
                            <ItemsPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border CornerRadius="12" Background="White" Margin="0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="2" Color="#40000000" Opacity="0.3"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="28"/>
                </Grid.RowDefinitions>

                <!-- ============ 顶部标题栏 ============ -->
                <Grid Grid.Row="0" Background="#4285f4" MouseLeftButtonDown="TitleBar_MouseDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 菜单按钮 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Ellipse Width="10" Height="10" Fill="White" Opacity="0.9" VerticalAlignment="Center"/>
                        <TextBlock Text=" AgoraIn · 课时划消" FontSize="13" FontWeight="SemiBold"
                                   Foreground="White" VerticalAlignment="Center" Margin="6,0,14,0"/>
                        <Button Content="文件" Style="{StaticResource FlatButton}" Foreground="White"
                                FontSize="13" Click="MenuFile_Click"/>
                        <Button Content="学生" Style="{StaticResource FlatButton}" Foreground="White"
                                FontSize="13" Click="MenuStudent_Click"/>
                        <Button Content="排课" Style="{StaticResource FlatButton}" Foreground="White"
                                FontSize="13" Click="MenuSchedule_Click"/>
                        <Button Content="帮助" Style="{StaticResource FlatButton}" Foreground="White"
                                FontSize="13" Click="MenuHelp_Click"/>
                    </StackPanel>

                    <!-- 右侧控制按钮 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="─" Width="46" Height="30" Foreground="White"
                                Background="Transparent" BorderThickness="0" FontSize="16"
                                Click="Minimize_Click" Cursor="Hand"/>
                        <Button Content="✕" Width="46" Height="30" Foreground="White"
                                Background="Transparent" BorderThickness="0" FontSize="14"
                                Click="Close_Click" Cursor="Hand"/>
                    </StackPanel>
                </Grid>

                <!-- ============ 主内容区（复用嵌入版划课界面） ============ -->
                <local:ClassHoursPanelControl Grid.Row="1" x:Name="HoursPanel"/>

                <!-- ============ 底部状态栏 ============ -->
                <Border Grid.Row="2" Background="#f5f5f5" Padding="12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="11" Foreground="#888" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="排课按学生编排 · 数据保存在本地" FontSize="11" Foreground="#aaa" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
