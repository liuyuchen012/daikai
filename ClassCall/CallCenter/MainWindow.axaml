<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CallCenter"
        x:Class="CallCenter.MainWindow"
        Title="班级呼叫系统 - 呼出端"
        Width="980" Height="680"
        MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">
    <Window.Resources>
        <local:OnlineToBrushConverter x:Key="OnlineConverter" />
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ 顶部：连接配置 ============ -->
        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="班级呼叫系统" FontSize="20" FontWeight="Bold" Foreground="#111827" />
                <TextBlock Text="呼出端（控制端）：选择目标教室，发送呼叫，被控端将弹窗提醒并通过 ClassIsland 朗读内容"
                           FontSize="12" Foreground="#6B7280" Margin="0,3,0,10" />

                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Column="0" Text="服务端地址" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#374151" />
                    <TextBox Grid.Column="1" x:Name="ServerBox" Height="30" />
                    <Button Grid.Column="2" x:Name="ConnectBtn" Content="连接" Width="72" Height="30" Margin="8,0,0,0"
                            Background="#2563EB" Foreground="White" Click="ConnectBtn_Click" />
                    <TextBlock Grid.Column="3" x:Name="ConnStatusText" Text="未连接" VerticalAlignment="Center"
                               Margin="10,0,0,0" Foreground="#EF4444" FontWeight="Bold" />
                    <TextBlock Grid.Column="4" Text="发送人" VerticalAlignment="Center" Margin="18,0,8,0" Foreground="#374151" />
                    <TextBox Grid.Column="5" x:Name="SenderBox" Width="150" Height="30" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- ============ 中部：设备列表 + 呼叫表单 ============ -->
        <Grid Grid.Row="1" ColumnDefinitions="300,14,*">

            <!-- 左侧：设备列表 -->
            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="12">
                <Grid RowDefinitions="Auto,*">
                    <DockPanel Grid.Row="0" Margin="2,0,2,8">
                        <TextBlock Text="教室设备" FontWeight="Bold" FontSize="15" Foreground="#111827" DockPanel.Dock="Left" />
                        <TextBlock x:Name="DeviceCountText" Text="(0)" FontSize="12" Foreground="#6B7280"
                                   HorizontalAlignment="Right" />
                    </DockPanel>
                    <ListBox Grid.Row="1" x:Name="DeviceList" SelectionMode="Single"
                             SelectionChanged="DeviceList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,6">
                                    <DockPanel>
                                        <Ellipse Width="10" Height="10" Fill="{Binding IsOnline, Converter={StaticResource OnlineConverter}}"
                                                 VerticalAlignment="Center" Margin="0,0,8,0" DockPanel.Dock="Left" />
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="14" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#6B7280" Margin="18,2,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 右侧：呼叫表单 -->
            <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="16">
                <StackPanel>
                    <TextBlock Text="发起呼叫" FontWeight="Bold" FontSize="15" Foreground="#111827" Margin="2,0,2,8" />

                    <!-- 呼叫类型 -->
                    <TextBlock Text="呼叫类型" FontSize="12" Foreground="#374151" Margin="2,4,0,4" />
                    <StackPanel Orientation="Horizontal" Margin="2,0,0,8" Spacing="18">
                        <RadioButton x:Name="TypeUrgent" GroupName="Type" Content="紧急呼叫" Foreground="#DC2626" />
                        <RadioButton x:Name="TypeNotice" GroupName="Type" Content="普通通知" Foreground="#374151" IsChecked="True" />
                        <RadioButton x:Name="TypeSpeech" GroupName="Type" Content="仅朗读（不弹窗）" Foreground="#374151" />
                    </StackPanel>

                    <!-- 呼叫目标 -->
                    <TextBlock Text="呼叫目标" FontSize="12" Foreground="#374151" Margin="2,4,0,4" />
                    <StackPanel Orientation="Horizontal" Margin="2,0,0,8" Spacing="18">
                        <RadioButton x:Name="TargetAll" GroupName="Target" Content="全部设备" IsChecked="True" />
                        <RadioButton x:Name="TargetOne" GroupName="Target" Content="已选设备" />
                        <TextBlock x:Name="TargetHintText" Text="（未选中设备时按全部发送）" FontSize="11"
                                   Foreground="#9CA3AF" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- 标题 -->
                    <TextBlock Text="呼叫标题" FontSize="12" Foreground="#374151" Margin="2,4,0,4" />
                    <TextBox x:Name="TitleBox" Height="32" Text="请班主任到办公室" />

                    <!-- 内容 -->
                    <TextBlock Text="呼叫内容（被控端将朗读此文字）" FontSize="12" Foreground="#374151" Margin="2,6,0,4" />
                    <TextBox x:Name="MessageText" Height="72" AcceptsReturn="True" TextWrapping="Wrap"
                             Text="请班主任听到广播后尽快到年级组办公室，有紧急事务需要处理。" />

                    <!-- 操作 -->
                    <StackPanel Orientation="Horizontal" Margin="2,14,0,0" Spacing="10">
                        <Button x:Name="SendBtn" Content="发送呼叫" Width="130" Height="38" FontSize="14"
                                Background="#2563EB" Foreground="White" Click="SendBtn_Click" />
                        <Button x:Name="RefreshBtn" Content="刷新设备" Width="90" Height="38"
                                Background="#E5E7EB" Foreground="#374151" Click="RefreshBtn_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ 底部：呼叫记录 ============ -->
        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="12" Margin="0,10,0,0">
            <Grid RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0" Text="呼叫记录" FontWeight="Bold" FontSize="14" Foreground="#111827" Margin="2,0,2,6" />
                <ListBox Grid.Row="1" x:Name="LogList" Height="130">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="14" Margin="2,3">
                                <TextBlock Text="{Binding TimeText}" Width="70" />
                                <TextBlock Text="{Binding TypeText}" Width="70" />
                                <TextBlock Text="{Binding Target}" Width="130" />
                                <TextBlock Text="{Binding Title}" Width="150" />
                                <TextBlock Text="{Binding SuccessText}" Width="50" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</Window>
