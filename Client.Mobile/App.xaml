<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:CheckIn.Client.Mobile"
             xmlns:converters="clr-namespace:CheckIn.Client.Mobile.Converters"
             x:Class="CheckIn.Client.Mobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <converters:BoolToColorConverter x:Key="BoolToColor" />
            <converters:RankColorConverter x:Key="RankColorConverter" />
            <converters:InverseBoolConverter x:Key="InverseBool" />
            <converters:StringNotEmptyConverter x:Key="StringNotEmpty" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
