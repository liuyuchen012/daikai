<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.Maui.Controls"
             x:Class="CheckIn.Client.Mobile.Pages.StudentScanPage"
             Title="扫码签到"
             BackgroundColor="#f5f6fa">

    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="16">

        <!-- 顶部提示 -->
        <Frame Grid.Row="0" BackgroundColor="#e8f0fe" CornerRadius="10"
               Padding="12" HasShadow="False" BorderColor="Transparent">
            <Label Text="扫描老师提供的签到二维码完成打卡"
                   FontSize="14" TextColor="#4285f4" HorizontalTextAlignment="Center" />
        </Frame>

        <!-- 扫码区域 -->
        <Grid Grid.Row="1">

            <!-- 相机扫码器 -->
            <VerticalStackLayout IsVisible="{Binding IsScanning}" Spacing="0">
                <zxing:CameraBarcodeReaderView
                    x:Name="barcodeReader"
                    IsDetecting="True"
                    HeightRequest="350"
                    HorizontalOptions="Fill" />
                <Label Text="将二维码对准扫码框" FontSize="13"
                       TextColor="#888888" HorizontalTextAlignment="Center"
                       Margin="0,8,0,0" />
            </VerticalStackLayout>

            <!-- 签到表单（扫码后显示） -->
            <Frame BackgroundColor="White" CornerRadius="12"
                   Padding="20" HasShadow="False" BorderColor="#e8e8e8"
                   IsVisible="{Binding ShowForm}"
                   VerticalOptions="Center">
                <VerticalStackLayout Spacing="14">

                    <Label Text="填写签到信息" FontSize="18" FontAttributes="Bold"
                           TextColor="#333333" HorizontalOptions="Center" />

                    <VerticalStackLayout Spacing="4">
                        <Label Text="签到码" FontSize="12" TextColor="#888888" />
                        <Frame BackgroundColor="#f0f4f8" CornerRadius="8" Padding="10"
                               HasShadow="False" BorderColor="Transparent">
                            <Label Text="{Binding ScannedShortCode}" FontSize="14"
                                   TextColor="#4285f4" FontAttributes="Bold" />
                        </Frame>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="你的姓名" FontSize="13" TextColor="#555555" />
                        <Entry Text="{Binding StudentName}" Placeholder="请输入姓名"
                               FontSize="15" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="签到密码" FontSize="13" TextColor="#555555" />
                        <Entry Text="{Binding SignPassword}" Placeholder="请输入老师提供的签到密码"
                               IsPassword="True" FontSize="15" />
                    </VerticalStackLayout>

                    <Button Text="确认签到"
                            Command="{Binding SubmitCommand}"
                            BackgroundColor="#4285f4" TextColor="White"
                            FontSize="16" FontAttributes="Bold"
                            CornerRadius="12" HeightRequest="52"
                            IsEnabled="{Binding CanSubmit}" />

                    <Button Text="重新扫码"
                            Command="{Binding RescanCommand}"
                            BackgroundColor="Transparent" TextColor="#888888"
                            BorderColor="#e0e0e0" BorderWidth="1"
                            CornerRadius="10" HeightRequest="40" FontSize="13" />

                    <ActivityIndicator IsRunning="{Binding IsSubmitting}"
                                       IsVisible="{Binding IsSubmitting}"
                                       Color="#4285f4" HorizontalOptions="Center" />

                </VerticalStackLayout>
            </Frame>

            <!-- 签到结果 -->
            <Frame BackgroundColor="White" CornerRadius="12"
                   Padding="24" HasShadow="False" BorderColor="#e8e8e8"
                   IsVisible="{Binding CheckInSuccess}"
                   VerticalOptions="Center">
                <VerticalStackLayout Spacing="16" HorizontalOptions="Center">
                    <Label Text="✅ 签到成功！" FontSize="22" FontAttributes="Bold"
                           TextColor="#34a853" HorizontalOptions="Center" />
                    <Label Text="{Binding ResultDetail}" FontSize="15"
                           TextColor="#666666" HorizontalTextAlignment="Center" />
                    <Button Text="再次签到"
                            Command="{Binding RescanCommand}"
                            BackgroundColor="#4285f4" TextColor="White"
                            CornerRadius="10" HeightRequest="44" FontSize="14"
                            Margin="0,8,0,0" />
                </VerticalStackLayout>
            </Frame>

            <!-- 错误提示 -->
            <Frame BackgroundColor="#fce8e6" CornerRadius="10"
                   Padding="16" HasShadow="False" BorderColor="Transparent"
                   IsVisible="{Binding HasError}"
                   VerticalOptions="Center">
                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                    <Label Text="{Binding ResultMessage}" FontSize="15"
                           TextColor="#c5221f" HorizontalTextAlignment="Center" />
                    <Button Text="重新扫码"
                            Command="{Binding RescanCommand}"
                            BackgroundColor="#ea4335" TextColor="White"
                            CornerRadius="10" HeightRequest="40" FontSize="13" />
                </VerticalStackLayout>
            </Frame>

        </Grid>

    </Grid>

</ContentPage>
