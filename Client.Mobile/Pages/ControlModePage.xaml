<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CheckIn.Client.Mobile.ViewModels"
             x:Class="CheckIn.Client.Mobile.Pages.ControlModePage"
             Title="控制"
             BackgroundColor="#f5f6fa">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16,12" RowSpacing="12">

        <!-- 操作栏 -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
            <Button Grid.Column="1" Text="刷新" Command="{Binding RefreshCommand}"
                    BackgroundColor="#4285f4" TextColor="White" FontSize="13"
                    CornerRadius="10" HeightRequest="40" WidthRequest="64" />
            <Button Grid.Column="2" Text="全选" Command="{Binding ToggleSelectAllCommand}"
                    BackgroundColor="#fbbc04" TextColor="White" FontSize="13"
                    CornerRadius="10" HeightRequest="40" WidthRequest="64" />
            <Button Grid.Column="3" Text="发送到所选" Command="{Binding SendToSelectedCommand}"
                    BackgroundColor="#ea4335" TextColor="White" FontSize="13"
                    CornerRadius="10" HeightRequest="40" WidthRequest="110" />
        </Grid>

        <!-- 状态栏 -->
        <Label Grid.Row="1" Text="{Binding StatusText}" FontSize="12" TextColor="#888888" />

        <!-- 设备列表 -->
        <RefreshView Grid.Row="2" IsRefreshing="{Binding IsLoading}" Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Devices}" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="暂无设备" TextColor="#888888" HorizontalOptions="Center" Margin="0,40" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:CallableDevice">
                        <Border BackgroundColor="White" StrokeShape="RoundRectangle 10"
                                Padding="12" Stroke="#e8e8e8" StrokeThickness="1" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalOptions="Center" Color="#4285f4" />
                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                    <Label Text="{Binding Name}" FontSize="14" TextColor="#333333" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding StatusText}" FontSize="11" TextColor="{Binding StatusColor}" />
                                </VerticalStackLayout>
                                <Ellipse Grid.Column="2" WidthRequest="10" HeightRequest="10"
                                         Fill="{Binding StatusColor}" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
