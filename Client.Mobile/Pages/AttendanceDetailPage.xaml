<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CheckIn.Client.Mobile.Pages.AttendanceDetailPage"
             Title="考勤详情"
             BackgroundColor="#f5f6fa">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="12">

        <!-- 标题 -->
        <Frame Grid.Row="0" BackgroundColor="White" CornerRadius="12"
               Padding="16" HasShadow="False" BorderColor="#e8e8e8">
            <VerticalStackLayout Spacing="4">
                <Label x:Name="lblSubject" Text="" FontSize="18" FontAttributes="Bold" TextColor="#333333" />
                <Label x:Name="lblShortCode" Text="" FontSize="12" TextColor="#888888" />
            </VerticalStackLayout>
        </Frame>

        <!-- 统计 -->
        <HorizontalStackLayout Grid.Row="1" Spacing="8">
            <Frame BackgroundColor="White" CornerRadius="8" Padding="10,8"
                   HasShadow="False" BorderColor="#e8e8e8" HorizontalOptions="FillAndExpand">
                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                    <Label Text="总人数" FontSize="11" TextColor="#888888" HorizontalOptions="Center" />
                    <Label x:Name="lblTotal" Text="0" FontSize="18" FontAttributes="Bold"
                           TextColor="#333333" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Frame>
            <Frame BackgroundColor="#e6f4ea" CornerRadius="8" Padding="10,8"
                   HasShadow="False" BorderColor="Transparent" HorizontalOptions="FillAndExpand">
                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                    <Label Text="已打卡" FontSize="11" TextColor="#34a853" HorizontalOptions="Center" />
                    <Label x:Name="lblCheckedIn" Text="0" FontSize="18" FontAttributes="Bold"
                           TextColor="#34a853" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Frame>
            <Frame BackgroundColor="#fce8e6" CornerRadius="8" Padding="10,8"
                   HasShadow="False" BorderColor="Transparent" HorizontalOptions="FillAndExpand">
                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                    <Label Text="未打卡" FontSize="11" TextColor="#ea4335" HorizontalOptions="Center" />
                    <Label x:Name="lblNotCheckedIn" Text="0" FontSize="18" FontAttributes="Bold"
                           TextColor="#ea4335" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Frame>
        </HorizontalStackLayout>

        <!-- 学生列表 -->
        <ScrollView Grid.Row="2">
            <VerticalStackLayout x:Name="studentListStack" Spacing="6" />
        </ScrollView>

    </Grid>

</ContentPage>
