<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Primary Colors -->
    <Color x:Key="Primary">#4285f4</Color>
    <Color x:Key="PrimaryDark">#3367d6</Color>
    <Color x:Key="PrimaryLight">#e8f0fe</Color>

    <!-- Status Colors -->
    <Color x:Key="Success">#34a853</Color>
    <Color x:Key="Warning">#FBBC04</Color>
    <Color x:Key="Danger">#EA4335</Color>

    <!-- Neutral Colors -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Background">#F0F2F5</Color>
    <Color x:Key="CardBackground">#FFFFFF</Color>
    <Color x:Key="BorderLight">#E8E8E8</Color>
    <Color x:Key="TextPrimary">#333333</Color>
    <Color x:Key="TextSecondary">#666666</Color>
    <Color x:Key="TextTertiary">#999999</Color>
    <Color x:Key="TextPlaceholder">#AAAAAA</Color>

    <!-- Ranking Colors -->
    <Color x:Key="Gold">#FFD700</Color>
    <Color x:Key="Silver">#C0C0C0</Color>
    <Color x:Key="Bronze">#CD7F32</Color>

    <!-- CheckIn Colors -->
    <Color x:Key="CheckedInBackground">#E8F5E9</Color>
    <Color x:Key="NotCheckedInBackground">#F5F5F5</Color>

    <!-- Menu Colors -->
    <Color x:Key="MenuHover">#e8f0fe</Color>
    <Color x:Key="MenuText">#333333</Color>

</ResourceDictionary>
