<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CheckIn.Client.Maui.ViewModels"
             x:Class="CheckIn.Client.Maui.Pages.CreateSignInPage"
             Title="创建签到任务"
             BackgroundColor="#F0F2F5">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12" MaximumWidthRequest="500">

            <!-- Title -->
            <Label Text="创建签到任务" FontSize="22" FontAttributes="Bold"
                   TextColor="#333333" Margin="0,0,0,8" />

            <!-- Sign Password -->
            <VerticalStackLayout Spacing="4">
                <Label Text="签到密码" FontSize="13" TextColor="#666666" />
                <Entry Text="{Binding SignPassword}" IsPassword="True"
                       Placeholder="学生签到使用的密码" />
            </VerticalStackLayout>

            <!-- Confirm Password -->
            <VerticalStackLayout Spacing="4">
                <Label Text="确认密码" FontSize="13" TextColor="#666666" />
                <Entry Text="{Binding ConfirmPassword}" IsPassword="True"
                       Placeholder="再次输入密码" />
            </VerticalStackLayout>

            <!-- Classroom -->
            <VerticalStackLayout Spacing="4">
                <Label Text="教室" FontSize="13" TextColor="#666666" />
                <Entry Text="{Binding Classroom}"
                       Placeholder="如：三（1）班" />
            </VerticalStackLayout>

            <!-- Subject -->
            <VerticalStackLayout Spacing="4">
                <Label Text="科目" FontSize="13" TextColor="#666666" />
                <Entry Text="{Binding Subject}"
                       Placeholder="如：数学" />
            </VerticalStackLayout>

            <!-- Student List -->
            <VerticalStackLayout Spacing="4">
                <Label Text="学生名单" FontSize="13" TextColor="#666666" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Label Text="{Binding StudentListStatus}"
                           FontSize="12" TextColor="#999999"
                           VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="导入CSV"
                             BackgroundColor="#4285f4" TextColor="White"
                             CornerRadius="6" HeightRequest="36"
                             FontSize="12" Padding="12,0"
                             Command="{Binding ImportCsvCommand}" />
                </Grid>
            </VerticalStackLayout>

            <!-- Hint -->
            <Label Text="提示：可使用打卡功能导出的 CSV 文件作为学生名单"
                   FontSize="11" TextColor="#AAAAAA" />

            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding IsCreating}"
                               IsVisible="{Binding IsCreating}"
                               Color="#4285f4" />
            <Label Text="{Binding ResultMessage}"
                   IsVisible="{Binding IsCreating}"
                   FontSize="12" TextColor="#4285f4"
                   HorizontalOptions="Center" />

            <!-- Create Button -->
            <Button Text="创建签到" BackgroundColor="#4285f4" TextColor="White"
                    CornerRadius="8" HeightRequest="44" FontSize="15"
                    Command="{Binding CreateCommand}"
                    IsEnabled="{Binding IsCreating, Converter={StaticResource InverseBoolConverter}}" />

            <!-- Success Result Section -->
            <Border IsVisible="{Binding HasResult}"
                    BackgroundColor="#FFFFFF" Stroke="#E8E8E8" StrokeThickness="1"
                    Padding="16" StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">

                    <!-- Success Icon -->
                    <Border WidthRequest="64" HeightRequest="64"
                            StrokeShape="RoundRectangle 32"
                            BackgroundColor="#34a853"
                            HorizontalOptions="Center">
                        <Label Text="&#x2713;" FontSize="32" TextColor="White"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>

                    <Label Text="创建成功" FontSize="18" FontAttributes="Bold"
                           TextColor="#333333" HorizontalOptions="Center" />

                    <Label Text="学生可通过以下链接或二维码进入签到页面"
                           FontSize="12" TextColor="#999999"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />

                    <!-- URL -->
                    <Border BackgroundColor="#F5F5F5" Padding="10,6"
                            StrokeShape="RoundRectangle 6">
                        <Label Text="{Binding SignUrl}" FontSize="11"
                               TextColor="#4285f4"
                               HorizontalTextAlignment="Center" />
                    </Border>

                    <!-- Copy Button -->
                    <Button Text="复制链接" BackgroundColor="#4285f4" TextColor="White"
                            CornerRadius="6" HeightRequest="36"
                            FontSize="13" HorizontalOptions="Center"
                            WidthRequest="140"
                            Command="{Binding CopyLinkCommand}" />
                </VerticalStackLayout>
            </Border>

            <!-- Close Button -->
            <Button Text="关闭" BackgroundColor="#F0F0F0" TextColor="#666666"
                    CornerRadius="8" HeightRequest="44" FontSize="15"
                    Command="{Binding CloseCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
